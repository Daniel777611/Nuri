{
  "name": "nuri-native-lab",
  "main": "expo-router/entry",
  "version": "0.3.0",
  "scripts": {
    "start": "expo start",
    "preview": "EXPO_PUBLIC_PREVIEW_MODE=1 PATH=\"$PWD/.tools/node20/bin:$PATH\" expo start --web --port 8081",
    "preview:clear": "EXPO_PUBLIC_PREVIEW_MODE=1 PATH=\"$PWD/.tools/node20/bin:$PATH\" expo start --web --clear --port 8081",
    "build:web": "expo export --platform web",
    "test:contracts": "node ./scripts/test-recommendation-entry-contract.mjs",
    "test:chat-context": "node ./scripts/test-chat-client-context-contract.mjs",
    "test:chat-feedback": "node ./scripts/test-chat-response-feedback-contract.mjs",
    "test:chat-image": "node ./scripts/test-chat-image-input-contract.mjs",
    "test:nuri-home": "node ./scripts/test-nuri-home-preview-contract.mjs",
    "test:native-push": "node ./scripts/test-native-push.mjs",
    "test:native-voice": "node ./scripts/test-native-voice-and-platform.mjs",
    "test:native-ui": "node --test ./src/components/__tests__/native-ui.test.mjs",
    "typecheck": "tsc --noEmit",
    "e2e:login": "playwright test e2e/login-recommendations.spec.ts",
    "e2e:login:prompt": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-e2e-login.ps1",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-sc": "0.4.3",
    "@expo/metro-runtime": "6.1.2",
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.4.0",
    "@react-navigation/elements": "2.3.8",
    "@react-navigation/native": "7.1.14",
    "@react-navigation/native-stack": "7.3.16",
    "date-fns": "4.1.0",
    "dayjs": "1.11.13",
    "expo": "~54.0.32",
    "expo-audio": "~1.1.1",
    "expo-clipboard": "~8.0.8",
    "expo-file-system": "~19.0.21",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-media-library": "~18.2.1",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.22",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-dotenv": "3.4.11",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/config-plugins": "54.0.5",
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.1.0",
    "eslint": "9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.3"
  },
  "resolutions": {
    "@eslint/plugin-kit": "0.3.4",
    "postcss": "8.5.10",
    "uuid": "11.1.1"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0"
}
