{
  "expo": {
    "name": "NURI Native Lab",
    "slug": "nuri-native-lab",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/native-lab-icon.png",
    "scheme": "nuri-native-lab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "en": "./locales/en.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json"
    },
    "ios": {
      "bundleIdentifier": "com.ordashtech.nuri.nativelab",
      "buildNumber": "1019",
      "appleTeamId": "6PL6HQYU7P",
      "supportsTablet": false,
      "entitlements": { "aps-environment": "production" },
      "infoPlist": {
        "CFBundleDisplayName": "Nuri",
        "CFBundleLocalizations": ["en", "zh-Hans", "zh-Hant"],
        "NuriAPNSEnvironment": "production",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": false }
      }
    },
    "android": {
      "package": "com.ordashtech.nuri",
      "versionCode": 4,
      "icon": "./assets/images/native-lab-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/native-lab-icon.png",
        "backgroundColor": "#E9E4F7"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "name": "NURI",
      "shortName": "NURI",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withNuriNative",
      "./plugins/withNuriAndroid",
      ["./plugins/withNuriGoogleSignIn", {
        "iosClientId": "22059260132-gpd9u7gra897fs9p7ue6n62sa0nppfuv.apps.googleusercontent.com",
        "webClientId": "22059260132-e9njjaftvdn0farumni9b67p6l17nfgt.apps.googleusercontent.com"
      }],
      ["expo-media-library", { "photosPermission": "允许 NURI 在你主动选择聊天图片或保存任务卡时使用相册。", "savePhotosPermission": "NURI 需要将你主动分享的任务卡保存到相册。" }],
      ["expo-audio", { "microphonePermission": "NURI 需要使用麦克风，将你主动录制的语音转成文字。" }],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 NURI 在你主动选择聊天图片或保存任务卡时使用相册。",
          "cameraPermission": "允许 NURI 使用相机，以便拍照并在对话中添加图片。",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
