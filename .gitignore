# secrets
.env
.streamlit/secrets.toml

# python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# model/cache
.cache/
*.bin

# chroma db (vector store files)
chroma_db/

# data files (PDFs, etc.)
data/

# internal RAG source docs — already ingested into Supabase (namespace=internal),
# kept local-only rather than committed
internelDatabase/

# golden agent transcripts (real customer PII, never commit data — scripts are fine)
backend/golden_agent/raw/
backend/golden_agent/processed/

# eval runs — model output, not fixtures. Committing one invites reading a
# single sample as the truth, which is the exact mistake the eval exists to stop.
backend/evals/out/

# OS/editor
.DS_Store
Thumbs.db
.vscode/4
.idea/
.vercel
.env*

# expo web export output
frontend/dist/
frontend/dist2/
frontend/dist3/

# operator-only recovery backups (may contain account history / PII)
.private-backups/
account-history-backups/

# Supabase CLI: local dependency tree and its scratch directory. The CLI is
# declared in the root package.json; the tree it installs is not source.
node_modules/
supabase/.temp/


# First-round test handoff. Carries the preview deployment URL and test account
# addresses; this repo has a public mirror, so the folder is delivered directly
# to the test party instead of being committed.
首轮测试交付/

# Everything sensitive lives here, so there is one rule to reason about rather
# than a scattered list that grows a hole every time a file is added. Credentials,
# the production .env backup, and the delivery bundle for the test party.
# `.env` itself has to stay at the repo root — load_dotenv() reads it from there.
private/
