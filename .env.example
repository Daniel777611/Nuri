OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VECTOR_NAMESPACE=pdf
SUPABASE_VECTOR_TABLE=rag_chunks
API_BASE=http://localhost:8000
JWT_SECRET=change-me
ADMIN_KEY=change-me-admin-secret

# ── Per-turn router ──────────────────────────────────────────────────────────
# Small, fast model that decides whether a turn needs external sources and
# whether it should produce task cards. Runs on every turn, so keep it small.
ROUTER_MODEL=gpt-5-mini
ROUTER_TIMEOUT_S=3.0
# Classification needs no deliberation. Measured on gpt-5-mini: 10.5s at the
# default effort vs 1.65s at minimal, for identical output quality.
ROUTER_REASONING_EFFORT=minimal

# ── External web search ──────────────────────────────────────────────────────
# null (default) = no search, the behaviour before external sources existed.
# stub = deterministic fake results for local work, never for production.
# tavily = live search; requires TAVILY_API_KEY below.
WEB_SEARCH_PROVIDER=null
# Measured against Tavily: one pass 1.9-2.3s, both language passes concurrently
# ~2.3s. 2.5s timed out on live queries.
WEB_SEARCH_TIMEOUT_S=4.0
WEB_SEARCH_MAX_RESULTS=5

# Secret. Real values belong in .env (git-ignored) and the Vercel dashboard —
# never here, and never in a commit.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
