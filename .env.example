OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VECTOR_NAMESPACE=pdf
SUPABASE_VECTOR_TABLE=rag_chunks
API_BASE=http://localhost:8000
JWT_SECRET=change-me
ADMIN_KEY=change-me-admin-secret

# ── Per-turn router (chat citations) ─────────────────────────────────────────
# Small, fast model deciding whether a turn's reply needs outside evidence.
# Runs on every turn, so keep it small. Classification needs no deliberation:
# measured on gpt-5-mini, 10.5s at the default effort against 1.65s at minimal.
ROUTER_MODEL=gpt-5-mini
ROUTER_TIMEOUT_S=4.5
ROUTER_REASONING_EFFORT=minimal

# ── Reply model ──────────────────────────────────────────────────────────────
# Measured on gpt-5.5 with the full persona and sources: 22.2s at the default,
# 12.5s at "low", for structurally identical output. "minimal" is not accepted
# by this model.
REPLY_REASONING_EFFORT=low

# ── Home-feed content research ───────────────────────────────────────────────
# Prepares the three recommendation cards ahead of time — see
# doc/recommendation_delivery_contract_v0_1.md. All have working defaults.
OPENAI_CONTENT_RESEARCH_MODEL=gpt-5.4-mini
# Per API call, not end to end: one prepare may make several.
OPENAI_CONTENT_RESEARCH_TIMEOUT_S=30
OPENAI_CONTENT_RESEARCH_CONCURRENCY=2
CONTENT_RESEARCH_CACHE_TTL_S=21600
CONTENT_RESEARCH_FAILURE_CACHE_TTL_S=180
CONTENT_RESEARCH_CACHE_MAX_ITEMS=128
# Secret. Encrypts recommendation snapshots; falls back to the Supabase service
# role key when unset, so local and deployed must agree or snapshots won't
# verify across them.
RECOMMENDATION_SNAPSHOT_SECRET=

# ── Chat-turn web search ─────────────────────────────────────────────────────
# Separate from OPENAI_CONTENT_RESEARCH_* above, which prepares the home feed.
# This one runs inside the turn and grounds the reply's citations.
#   null (default) = no search, the behaviour before citations existed
#   stub           = deterministic fake results for local work, never production
#   tavily         = live search; requires TAVILY_API_KEY
WEB_SEARCH_PROVIDER=null
WEB_SEARCH_TIMEOUT_S=6.0
# Tavily's latency tracks this, not the domain list: 5 results ~2.4s, 3 ~0.74s.
WEB_SEARCH_MAX_RESULTS=3

# Secret. Real values belong in .env (git-ignored) and the Vercel dashboard.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
