{
  "expo": {
    "name": "NURI",
    "slug": "nuri-mobile-shell",
    "version": "0.2.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nuri",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ordashtech.nuri",
      "buildNumber": "13",
      "supportsTablet": false,
      "entitlements": {
        "aps-environment": "$(APS_ENVIRONMENT)"
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSCameraUsageDescription": "NURI 需要使用相机，让你在对话中拍摄图片并交由 AI 分析。",
        "NSMicrophoneUsageDescription": "NURI 需要使用麦克风，让你可直接用语音与 AI 对话。",
        "NSPhotoLibraryUsageDescription": "NURI 需要读取你主动选择的照片，将其添加到对话并交由 AI 分析。",
        "NSPhotoLibraryAddUsageDescription": "NURI 会把你在对话中拍摄的照片保存到系统相册，方便你之后查看和管理。"
      }
    },
    "android": {
      "package": "com.ordashtech.nuri",
      "versionCode": 1
    },
    "extra": {
      "nuriWebOrigin": "https://nurifam.app"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
