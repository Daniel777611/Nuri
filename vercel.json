{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd native-ios && npx -y pnpm@11.25.0 install --frozen-lockfile && npx expo export --platform web",
  "outputDirectory": "native-ios/dist",
  "functions": {
    "api/backend.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/backend.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/backend.py"
    },
    {
      "source": "/index",
      "destination": "/api/backend.py"
    },
    {
      "source": "/ask",
      "destination": "/api/backend.py"
    },
    {
      "source": "/health",
      "destination": "/api/backend.py"
    },
    {
      "source": "/admin/logs",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/backend.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/push/dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/care/generate",
      "schedule": "0 15 * * *"
    }
  ]
}
