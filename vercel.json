{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd native-ios && npx -y pnpm@11.25.0 install --frozen-lockfile && npx -y pnpm@11.25.0 run build:web:ios-parity",
  "outputDirectory": "native-ios/dist",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    },
    {
      "source": "/ask",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://nuri-git-testing-backend-beta-ordashtech.vercel.app/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://nuri-git-testing-backend-beta-ordashtech.vercel.app/api/$1"
    },
    {
      "source": "/index",
      "destination": "https://nuri-git-testing-backend-beta-ordashtech.vercel.app/index"
    },
    {
      "source": "/ask",
      "destination": "https://nuri-git-testing-backend-beta-ordashtech.vercel.app/ask"
    },
    {
      "source": "/health",
      "destination": "https://nuri-git-testing-backend-beta-ordashtech.vercel.app/health"
    },
    {
      "source": "/admin/logs",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://nuri-git-testing-backend-beta-ordashtech.vercel.app/admin/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
